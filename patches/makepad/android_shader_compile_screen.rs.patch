+/// True when the on-disk GL program binary cache has no entries for this
+/// device fingerprint — same idea as Makepad `PIPELINE_CACHE_COLD` (#1459).
+fn android_gl_program_cache_is_cold(os_type: &OsType) -> bool {
+    let OsType::Android(params) = os_type else {
+        return false;
+    };
+    let cache_dir = std::path::Path::new(&params.cache_path);
+    let Ok(entries) = std::fs::read_dir(cache_dir) else {
+        return true;
+    };
+    let needle = format!(
+        "_av{}_bn{}_kv{}",
+        params.android_version, params.build_number, params.kernel_version
+    );
+    for entry in entries.flatten() {
+        let name = entry.file_name();
+        let Some(name) = name.to_str() else {
+            continue;
+        };
+        if name.starts_with("shader_") && name.ends_with(".bin") && name.contains(&needle) {
+            return false;
+        }
+    }
+    true
+}
