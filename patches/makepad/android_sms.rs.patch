+/// Wadhu SMS Gateway: send SMS via the device SIM (MakepadActivity.sendSms).
+pub unsafe fn to_java_send_sms(to: String, body: String) -> bool {
+    let env = attach_jni_env();
+    let Ok(to) = CString::new(to) else {
+        return false;
+    };
+    let Ok(body) = CString::new(body) else {
+        return false;
+    };
+    let to = ((**env).NewStringUTF.unwrap())(env, to.as_ptr());
+    let body = ((**env).NewStringUTF.unwrap())(env, body.as_ptr());
+    let ok = ndk_utils::call_bool_method!(
+        env,
+        get_activity(),
+        "sendSms",
+        "(Ljava/lang/String;Ljava/lang/String;)Z",
+        to,
+        body
+    );
+    ok != 0
+}
