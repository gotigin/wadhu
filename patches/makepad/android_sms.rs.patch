+/// Wadhu SMS Gateway: coarse SIM/permission status string from Java.
+pub unsafe fn to_java_sms_radio_status() -> String {
+    let env = attach_jni_env();
+    let result = ndk_utils::call_object_method!(
+        env,
+        get_activity(),
+        "smsRadioStatus",
+        "()Ljava/lang/String;"
+    );
+    if result.is_null() {
+        return "error".to_string();
+    }
+    jstring_to_string(env, result)
+}
