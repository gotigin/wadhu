# Meta App credentials — never commit real values
META_APP_ID=
META_APP_SECRET=
META_CONFIG_ID=
META_GRAPH_VERSION=v22.0

# Webhook verify token you choose (must match App Dashboard webhook config)
WEBHOOK_VERIFY_TOKEN=gotigin_wa_verify_change_me

# Optional: HTTPS public origin for Embedded Signup (ngrok/cloudflared URL)
PUBLIC_ORIGIN=https://localhost:8443

# Server
PORT=3847
HOST=127.0.0.1

# Persist connection state under ./data (gitignored)
DATA_DIR=./data
