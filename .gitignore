# Rust / Cargo
/target/
**/target/
**/*.rs.bk
*.pdb

# Packaged builds (linux / windows / android / web / …)
/dist/

# Stray desktop / mobile binaries if dropped outside /dist/
*.exe
*.dll
*.so
*.dylib
*.apk
*.aab
*.msi
*.AppImage
*.dmg

# Makepad: generated by scripts/setup-makepad.sh (never commit the tree)
/vendor/makepad/
/vendor/makepad-full/
/vendor/*
!/vendor/.gitkeep
**/.makepad/

# Local runtime / screenshots / scratch (not source)
/local/
*.log
*.tmp
*.temp

# App / relay runtime data (never commit live state)
**/wadhu-sms-gateway-data/
**/wadhu-sms-relay-data/
**/sms-relay-data/
**/gateway-state.json
**/gateway-state.json.tmp
**/relay-state.json
**/relay-state.json.tmp
**/*.sqlite3
**/*.sqlite3-wal
**/*.sqlite3-shm
**/backups/

# Secrets / local env overrides
# Tracked templates stay as apps/*/env/development.env and production.env
.env
.env.*
!.env.example
!**/.env.example

# OS / editor noise
.DS_Store
Thumbs.db
Desktop.ini
*~
*.swp
*.swo
.idea/
*.iml

# Keep shared Cursor rules; ignore personal/local Cursor junk
.cursor/*
!.cursor/rules/
!.cursor/rules/**

# Keep .vscode/tasks.json in git; ignore personal overrides
.vscode/*.code-workspace
.vscode/settings.json
.vscode/launch.json
.vscode/extensions.json

# Coverage / profiling
**/coverage/
**/*.profraw
**/flamegraph.svg
.tmp/
